{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "3d-constellation-tracker",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/starlink-handover-visualizer",
  "functions": {
    "api/tle.ts": {
      "runtime": "edge"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}